[Unit]
Description=Cópias do terceiro cérebro a cada 3 horas

[Timer]
# A VM está em UTC: 00, 03, 06... UTC = 21, 00, 03... de Brasília. Fresco o bastante para o PAINEL.md e ainda leve
# (repositórios só puxam o que mudou; documentos são um rsync).
OnCalendar=*-*-* 00/3:00:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
